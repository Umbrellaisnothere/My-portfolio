# Copy this file to .env and fill in local values.
# Never commit .env or real passwords / API keys.

# API port
PORT=3001

# Allowed frontend origin(s), comma-separated.
# Use the origin only (scheme + host + port), not a page path.
FRONTEND_URL=http://127.0.0.1:8000,http://localhost:8000

# Set to true when the API sits behind a reverse proxy (Render, Railway, nginx).
TRUST_PROXY=false

# Brevo transactional email API. Set these in the host environment UI in production.
BREVO_API_KEY=your_brevo_api_key
EMAIL_FROM=verified-sender@example.com
EMAIL_FROM_NAME=Portfolio Contact
EMAIL_TO=your-receiving-email@example.com

# Optional. When true, the API validates and accepts messages without sending mail.
EMAIL_DRY_RUN=true

# POST /send-email is limited to 5 requests per 15 minutes per IP.
# RATE_LIMIT_MAX=5
# RATE_LIMIT_WINDOW_MS=900000
