# Copy this file to .env and fill in local values.
# Never commit .env or real passwords.

# API port
PORT=3001

# Allowed frontend origin(s), comma-separated.
# Use the origin only (scheme + host + port), not a page path.
FRONTEND_URL=http://127.0.0.1:8000,http://localhost:8000

# Set to true when the API sits behind a reverse proxy (Render, Railway, nginx).
TRUST_PROXY=false

# SMTP account used to send mail. The visitor never sees these values.
EMAIL_USER=your-email@example.com
EMAIL_PASS=your-smtp-or-app-password
EMAIL_TO=your-email@example.com

# SMTP host settings. Example for Gmail: smtp.gmail.com, 587, false
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false

# Optional. When true, the API validates and accepts messages without sending mail.
EMAIL_DRY_RUN=false

# POST /send-email is limited to 5 requests per 15 minutes per IP.
# RATE_LIMIT_MAX=5
# RATE_LIMIT_WINDOW_MS=900000
